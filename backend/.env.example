# ReelBrief Configuration

# Security & Server
API_TOKEN=change-this-to-a-secure-random-token
ALLOWED_ORIGINS=chrome-extension://your-extension-id-here

# Storage & Authentication
COOKIES_FILE=data/cookies.txt

# LLM Extraction
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Media Processing Models
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Worker Throttling & Limits
PROCESS_DELAY_SECONDS=8
DAILY_CAP=100

# Optional Resolvers & Integrations
GITHUB_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/oauth/spotify/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
